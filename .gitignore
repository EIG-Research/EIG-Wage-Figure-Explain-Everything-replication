# .gitignore for the public replication repository.
# Keeps source data, large derived files, secrets, and local cruft out of version control.

# API keys. Keep them in a user-level .Renviron, never in the repository.
.Renviron
.env

# Raw data: IPUMS microdata and third-party source files are not redistributed (see
# DATA.md). The EIG-built minimum-wage inputs are tracked and re-included below.
data/raw/*
!data/raw/cps_org/
data/raw/cps_org/*
!data/raw/cps_org/README.md
!data/raw/minimum_wage/
data/raw/minimum_wage/*
!data/raw/minimum_wage/concordance/
!data/raw/minimum_wage/extension/
data/raw/minimum_wage/extension/*
!data/raw/minimum_wage/extension/2023-onward.yaml
*.dat
*.dat.gz
*.csv.gz
data/allitems.xlsx

# Intermediate checkpoints written by the pipeline; the small diagnostic CSVs and the
# README are tracked.
data/intermediate/*
!data/intermediate/README.md
!data/intermediate/*.csv
data/intermediate/minimum_wage/

# FRED pulls are regenerated by the pipeline.
data/fred/*
!data/fred/deflators/
data/fred/deflators/*
!data/fred/deflators/README.md

# EPI State of Working America data library (optional, user-downloaded).
data/epi_swa_data_library/*
!data/epi_swa_data_library/README.md

# Large or regenerable formats.
*.parquet
*.rds
*.RData

# Licensed brand fonts are never redistributed.
code/_utils/fonts/

# Validation reports written on every run; the benchmark CSVs are tracked.
output/verification/*
!output/verification/*.csv

# Logs and scratch
output/logs/
*.log
temp/

# R / RStudio
.Rproj.user/
.Rhistory
.Ruserdata

# Python
__pycache__/
*.pyc
.venv/

# OS / editor cruft
.DS_Store
Thumbs.db
*~
.vscode/
.idea/
